# Required
ADMIN_PASSWORD=change-me-please
# Used to encrypt provider credentials in SQLite. Generate with: openssl rand -base64 32
APP_SECRET_KEY=

# Optional
PORT=8080
# Set to true when served over HTTPS (behind a TLS proxy)
COOKIE_SECURE=false
TRUST_PROXY=false
SESSION_TTL_SEC=43200
META_REFRESH_SEC=3600
# Optional: raises the GitHub API rate limit for /meta polling
GITHUB_TOKEN=
SCHEDULER_TICK_SEC=15
MAX_IPS_PER_RECORD=16
MIN_TTL=60
MIN_INTERVAL_SEC=60

# Lab BIND9 (docker compose --profile lab). Generate with: openssl rand -base64 32
LAB_TSIG_SECRET=
